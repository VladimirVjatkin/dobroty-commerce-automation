      "parameters": {
        "jsCode": "function escapeMarkdownV2(text) {\n  return text\n    .replace(/\\*/g, '\\\\*')\n    .replace(/_/g, '\\\\_')\n    .replace(/\\[/g, '\\\\[')\n    .replace(/\\]/g, '\\\\]')\n    .replace(/\\(/g, '\\(')\n    .replace(/\\)/g, '\\)')\n    .replace(/~/g, '\\\\~')\n    .replace(/`/g, '\\\\`')\n    .replace(/>/g, '\\\\>')\n    .replace(/#/g, '\\\\#')\n    .replace(/\\+/g, '\\+')\n    .replace(/-/g, '\\-')\n    .replace(/=/g, '\\\\=')\n    .replace(/\\|/g, '\\\\|')\n    .replace(/{/g, '\\\\{')\n    .replace(/}/g, '\\\\}')\n    .replace(/!/g, '\\!')\n}\n\nreturn items.map(item => {\n  const originalText = item.json.output || '';\n  const cleaned = escapeMarkdownV2(originalText);\n  return {\n    json: {\n      text: cleaned\n    }\n  };\n});\n"
      },
